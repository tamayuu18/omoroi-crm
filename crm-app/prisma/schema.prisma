generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


model Customer {
  id           String    @id @default(cuid())
  registeredAt DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  inflow       String?
  foresmaId    String?
  name         String
  kana         String?
  phone        String?
  email        String?
  age          String?
  birthDate    String?   // 生年月日 (YYYY-MM-DD)。あれば年齢はここから自動算出
  education    String?   // 最終学歴
  gender       String?
  area         String?
  company      String?
  job          String?
  salary       String?
  hopeJob      String?
  hopeArea     String?
  hopeSalary   String?
  timing       String?
  ca           String?
  status       String    @default("初回未対応")
  yomiRank     String?
  nextAction   String?
  nextDeadline DateTime?
  lastContact  DateTime?
  expectedCloseMonth String?
  expectedRevenue    String?
  feeRate            String?
  fixedFee           String?
  note         String?
  recommendation     String?
  photoUrl           String?

  tasks     Task[]
  meetings  Meeting[]
  history   History[]
  yomi      Yomi[]
  proposals JobProposal[]

  @@index([status])
  @@index([ca])
}

// 求人マスタ
model Job {
  id        String   @id @default(cuid())
  company   String          // 企業名
  title     String          // 職種・ポジション
  area      String?         // 勤務地
  salary    String?         // 想定年収
  employment String?        // 雇用形態
  feeRate   String?         // 手数料率
  status    String   @default("募集中")  // 募集中/停止/クローズ
  source    String?         // 取得元媒体（circus / jobins / manual）
  sourceUrl String?         // 元求人票URL
  detail    String?         // 求人詳細・条件
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  proposals JobProposal[]

  @@index([status])
}

// 求人提案（顧客 × 求人）
model JobProposal {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  ca         String?
  status     String    @default("提案")  // 提案/意思確認/応募/書類選考/面接/内定/承諾/辞退/見送り
  proposedAt DateTime  @default(now())
  interviewDate DateTime? // 面接日
  decidedAt  DateTime?
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  proposalNotes ProposalNote[]

  @@index([customerId])
  @@index([jobId])
  @@index([proposedAt])
}

// 提案ごとの社内メモ（追記専用・編集/削除UIなし＝過去の記録は消えない）
model ProposalNote {
  id         String      @id @default(cuid())
  proposalId String
  proposal   JobProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  content    String
  createdBy  String?
  createdAt  DateTime    @default(now())

  @@index([proposalId])
}

model Task {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name          String
  ca            String?
  content       String
  deadline      DateTime?
  status        String    @default("未対応")
  assignee      String?
  priority      String?
  relatedStatus String?
  doneAt        DateTime?
  note          String?
  createdAt     DateTime  @default(now())

  @@index([customerId])
  @@index([deadline])
  @@index([status])
}

model Meeting {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  ca           String?
  date         DateTime?
  startTime    String?
  endTime      String?
  method       String?
  status       String    @default("予約済")
  remind       String?
  result       String?
  temp         String?
  proposal     String?
  nextAction   String?
  nextDeadline DateTime?
  createdAt    DateTime  @default(now())

  @@index([customerId])
  @@index([date])
}

model History {
  id           String    @id @default(cuid())
  customerId   String
  customer     Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name         String
  ca           String?
  date         DateTime  @default(now())
  type         String?
  result       String?
  content      String?
  nextContent  String?
  nextDeadline DateTime?
  createdBy    String?
  createdAt    DateTime  @default(now())

  @@index([customerId])
}

model Yomi {
  id              String    @id @default(cuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name            String
  ca              String?
  status          String?
  rank            String?
  probability     String?
  expectedMonth   String?
  expectedJoinDate DateTime?
  expectedSalary  String?
  feeRate         String?
  expectedRevenue String?
  weightedRevenue String?
  reason          String?
  obstacles       String?
  nextAction      String?
  nextDeadline    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([customerId])
}
